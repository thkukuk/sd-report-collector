      "id": 105,
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.host == \"${host}\" and r._field == \"value\" and (r._measurement == \"org.openSUSE.rebootmgr.MaintenanceWindowStart\" or r._measurement == \"org.openSUSE.rebootmgr.MaintenanceWindowDuration\"))\n  |> last()\n  |> pivot(rowKey: [\"_start\"], columnKey: [\"_measurement\"], valueColumn: \"_value\")\n  |> map(fn: (r) => {\n      totalSec = int(v: r[\"org.openSUSE.rebootmgr.MaintenanceWindowDuration\"])\n      h = totalSec / 3600\n      m = (totalSec % 3600) / 60\n      s = totalSec % 60\n      hs = if h < 10 then \"0\" + string(v: h) else string(v: h)\n      ms = if m < 10 then \"0\" + string(v: m) else string(v: m)\n      ss = if s < 10 then \"0\" + string(v: s) else string(v: s)\n      return {_value: r[\"org.openSUSE.rebootmgr.MaintenanceWindowStart\"] + \" (+\" + hs + \":\" + ms + \":\" + ss + \")\"}\n    })\n  |> keep(columns: [\"_value\"])",
          "refId": "A"
        }
      ],
      "title": "Maintenance Window",
      "type": "stat",
