            "uid": "${DS_INFLUXDB}"
          },
          "query": "import \"date\"\n\nfrom(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.host == \"${host}\" and r._field == \"value\" and (r._measurement == \"org.openSUSE.rebootmgr.RebootScheduledTime\" or r._measurement == \"org.openSUSE.rebootmgr.RebootStatus\" or r._measurement == \"org.openSUSE.rebootmgr.RebootDisabled\"))\n  |> last()\n  |> pivot(rowKey: [\"_start\"], columnKey: [\"_measurement\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_value: if r[\"org.openSUSE.rebootmgr.RebootDisabled\"] == \"true\" or r[\"org.openSUSE.rebootmgr.RebootStatus\"] == \"not-requested\" then \"N/A\" else string(v: date.truncate(t: time(v: int(v: r[\"org.openSUSE.rebootmgr.RebootScheduledTime\"]) * 1000), unit: 1s))}))\n  |> keep(columns: [\"_value\"])",
          "refId": "A"
        }
      ],
