[Unit]
Description=systemd-report mTLS collecting server
After=network.target

[Service]
Type=simple
ExecStart=/usr/lib/sd-report-collector/sd-report-collector
Restart=on-failure
DynamicUser=yes
StateDirectory=sd-report-collector
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/sd-report-collector

[Install]
WantedBy=multi-user.target
