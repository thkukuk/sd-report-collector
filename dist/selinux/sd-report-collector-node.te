module sd-report-collector-node 1.0;

# sd-report-collector-node.service runs /usr/lib/systemd/systemd-report, which
# has no SELinux domain of its own and therefore runs as init_t.

require {
	type init_t;
	type http_port_t;
	class tcp_socket name_connect;
}

# Upload reports to the collector (default port 8443 is labeled http_port_t).
allow init_t http_port_t:tcp_socket name_connect;

# Collect rebootmgr metrics. Optional, so the module also loads on systems
# without rebootmgr's policy.
optional {
	require {
		type rebootmgr_t;
		class unix_stream_socket connectto;
	}
	allow init_t rebootmgr_t:unix_stream_socket connectto;
}
