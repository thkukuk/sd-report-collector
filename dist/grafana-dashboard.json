          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"io.systemd.Manager.SystemState\" and r._field == \"value\" and r.host == \"${host}\")\n  |> last()",
          "refId": "A"
        }
      ],
      "title": "System State",
      "type": "stat",
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
