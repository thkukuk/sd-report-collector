[Unit]
Description=Push regular reports to the collector server
After=network.target local-fs.target
Wants=network-online.target
Wants=systemd-report-basic.socket systemd-report-cgroup.socket systemd-report-diskspace.socket systemd-report-files.socket systemd-report-hwmon.socket systemd-report-diskhealth.socket
Wants=systemd-journalctl-metrics.socket
Wants=systemd-journald-metrics.socket systemd-logind-metrics.socket systemd-report-netstat.socket
Wants=metrics-exporter.socket
# imds and networkd are not used by default, avoid errors in the log
#Wants=systemd-imds-metrics.socket
# systemd-networkd-varlink-metrics.socket get's enabled if you enable networkd
#Wants=systemd-networkd-varlink-metrics.socket
Requires=systemd-report.socket

[Timer]
OnCalendar=*:0/5

[Install]
WantedBy=timers.target
