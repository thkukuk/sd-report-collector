[Unit]
Description=Push regular reports to the collector server
After=network.target local-fs.target
Wants=network-online.target
Wants=systemd-report-basic.socket systemd-report-cgroup.socket systemd-report-diskspace.socket systemd-report-files.socket systemd-report-hwmon.socket
Wants=systemd-journalctl-metrics.socket
# imds and networkd are not used by default, avoid errors in the log
#Wants=systemd-imds-metrics.socket systemd-networkd-varlink-metrics.socket
Requires=systemd-report.socket

[Timer]
OnCalendar=*:0/5

[Install]
WantedBy=timers.target
